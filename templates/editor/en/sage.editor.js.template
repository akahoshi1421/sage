/**
 * Declarations that adapt sage's web editor (Monaco Editor) to the technology being learned. Optional.
 * Loaded as an ES module both in the browser and by sage's server, so keep browser-only code out of the top level.
 *
 * Principle: sage knows nothing about languages. If a language server (LSP) exists it is connected; otherwise the
 * plain editor is used (learning still works). There is no need to hand-write completion or highlighting.
 */

/**
 * File extensions (without the dot) sage does not know -> Monaco language id.
 * Common languages (.py .go .rs .c .ts ...) need no entry. The id is used for both the editor and the language server.
 */
export const languages = {
  // mbt: "moonbit",
};

/**
 * Language server command per Monaco language id. sage starts it at the project root and relays it to the editor.
 * Languages without an entry use sage's defaults (python: pyright-langserver, go: gopls, c/cpp: clangd,
 * rust: rust-analyzer, typescript: typescript-language-server, ...) when the command is on PATH, so installing
 * the server is usually enough. Declare only commands that are not on PATH or languages without a default.
 */
export const languageServers = {
  // python: { command: "python3", args: ["-m", "pyright.langserver", "--stdio"] },
  // moonbit: { command: "moon", args: ["lsp"] },
  // ruby: { command: "ruby-lsp", cwd: "playground" }, // use the playground/ environment (Gemfile, ...) as the workspace
};

/*
 * The following is advanced and normally unnecessary.
 * - setup({ monaco, project }): once when Monaco has loaded. Register type definitions and the like
 * - open({ monaco, editor, project, question }): every time a question is opened. Configure the editor (IStandaloneCodeEditor)
 *   question is { number, slug, difficulty, title, answerFileName, answerFilePath, language }
 * - project: { rootUri, readFiles(dir, suffixes), readFile(path) } reads files inside the project (nothing outside)
 * Only URLs can be imported. Errors show up in the browser console.
 *
 * Example: register an npm package's type definitions with Monaco's TypeScript without a language server
 *
 * export async function setup({ monaco, project }) {
 *   const files = await project.readFiles("node_modules/zod", [".d.ts", ".d.cts", "package.json"]);
 *   for (const [file, content] of Object.entries(files)) {
 *     monaco.languages.typescript.typescriptDefaults.addExtraLib(content, `${project.rootUri}/${file}`);
 *   }
 * }
 */
