/**
 * sage の Web エディタ (Monaco Editor) を学習対象に合わせるための宣言。省略可。
 * ブラウザと sage のサーバーの両方で ES モジュールとして読み込むので、トップレベルにはブラウザ専用の処理を書かない。
 *
 * 基本方針: sage は言語を知らない。言語サーバー (LSP) があればそれにつなぎ、無ければ素のエディタで動く (学習は成立する)。
 * 補完や色付けを自作する必要はない。
 */

/**
 * sage が知らない拡張子 (ドット無し) → Monaco の言語 ID。
 * 一般的な言語 (.py .go .rs .c .ts など) は宣言しなくてよい。宣言した言語 ID はエディタと言語サーバーの両方に使う。
 */
export const languages = {
  // mbt: "moonbit",
};

/**
 * 言語サーバーの起動コマンド (Monaco の言語 ID ごと)。sage がプロジェクトのルートで起動し、エディタと中継する。
 * 宣言が無い言語は既定の候補 (python: pyright-langserver、go: gopls、c/cpp: clangd、rust: rust-analyzer、
 * typescript: typescript-language-server など) のうち PATH にあるものを使うので、入れておけば宣言は不要。
 * PATH に無いコマンドや既定に無い言語だけここに書く。
 */
export const languageServers = {
  // python: { command: "python3", args: ["-m", "pyright.langserver", "--stdio"] },
  // moonbit: { command: "moon", args: ["lsp"] },
};

/*
 * 以下は上級者向けで、通常は不要。
 * - setup({ monaco, project }): Monaco 読み込み時に 1 回。型定義の登録など
 * - open({ monaco, editor, project, question }): 問題を開くたび。エディタ (IStandaloneCodeEditor) の設定
 *   question は { number, slug, difficulty, title, answerFileName, answerFilePath, language }
 * - project: { rootUri, readFiles(dir, suffixes), readFile(path) } でプロジェクト内のファイルを読める (外は読めない)
 * import できるのは URL だけ。失敗はブラウザのコンソールに出る。
 *
 * 例: 言語サーバーを使わずに npm パッケージの型定義を Monaco の TypeScript に登録する
 *
 * export async function setup({ monaco, project }) {
 *   const files = await project.readFiles("node_modules/zod", [".d.ts", ".d.cts", "package.json"]);
 *   for (const [file, content] of Object.entries(files)) {
 *     monaco.languages.typescript.typescriptDefaults.addExtraLib(content, `${project.rootUri}/${file}`);
 *   }
 * }
 */
